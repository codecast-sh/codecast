# Local demo/marketing video renders (large media, never committed)
videos/

# Scratch UI harnesses (throwaway, per-session). A session builds a standalone
# page to verify one component in Chrome, then abandons it — nothing under this
# prefix is tracked, so ignore the whole convention rather than each new name.
packages/web/_*.tsx
packages/web/_*.html
packages/web/public/_*.html
packages/web/_chiptest.*
dist-ssr/

# Private production bundles built for CPU profiling (hundreds of MB)
packages/web/dist-perf/

# Social posting tooling (private ops, keys and account workflow)
scripts/publora.mjs
docs/social-posting.md

# Test debris: a snippet-installer test resolved its target through a colorized
# `ls`, so it created a directory literally named with an ANSI escape sequence
# plus an absolute scratchpad path. Never a real source path.
packages/cli/*
# Editor/atomic-write temp files (name.tsx.tmp.<pid>.<hash>)
*.tmp.[0-9]*.[0-9a-f]*

# Scratch convex probes (one-off prod queries, never shipped)
packages/convex/_*.mjs
_tok.json
packages/web/public/_tok.json
packages/web/tsconfig.*.tmp.json

# tsc incremental state, regenerated on every typecheck
packages/web/tsconfig.tsbuildinfo
