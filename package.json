{
  "name": "codecast",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "cd packages/web && bun run start",
    "dev": "./dev.sh",
    "build": "turbo run build --filter='!@codecast/electron' --filter='!mobile'",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "postinstall": "bash patches/convex-auth-iss-fix.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@codecast/web": "workspace:*",
    "convex": "^1.31.6"
  },
  "overrides": {
    "@radix-ui/react-slot": "1.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
