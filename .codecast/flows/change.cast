// How this project's change differs from the library's: one line per edit (cast flow edit change --help).
digraph change {
  graph [extends="change"]
  local_ci [before="pr", label="Local CI", shape=parallelogram, script="wt=\"$(cast ws path $worktree)\" && cd \"$wt\" && grep -q -- --budget scripts/ci/local.ts || { echo \"Local CI did not run: the run has no worktree, or this change predates scripts/ci/local.ts --budget. CI judges the change.\"; exit 0; }; rm -f \"$run_dir/local-ci.json\"; bun scripts/ci/local.ts --no-typecheck --budget 15 --json \"$run_dir/local-ci.json\"; lc_exit=$?; [ $lc_exit -eq 1 ] && [ ! -s \"$run_dir/local-ci.json\" ] && echo \"No verdict: local.ts exited 1 without writing its result, so it crashed.\" && lc_exit=2; case \"$local_ci_fix.visits\" in [1-9]*) [ $lc_exit -eq 1 ] && echo \"Still red after the session's turn on it: the pull request opens, and CI judges it against main.\" && lc_exit=0;; esac; [ $lc_exit -ne 1 ]", timeout=1800, fix="local_ci_fix"]
  // Local CI's own way back: the Fix findings brief reads CI's and the reviewer's verdicts, which do not exist yet here.
  // It sends a change back once per run; red again, it goes on to CI, which tells the change's failures from main's.
  local_ci_fix [label="Fix Local CI", backend=subject, max_visits=3, prompt="@change/local_ci_fix.md"]
  local_ci_fix -> local_ci
}
