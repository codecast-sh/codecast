// How this project's change differs from the library's: one line per edit (cast flow edit change --help).
digraph change {
  graph [extends="change"]
  local_ci [before="pr", label="Local CI", shape=parallelogram, script="[ \"$sent_back_from\" = local_ci_fix ] && [ \"$local_ci_fix.moved\" = false ] && { echo \"Fix Local CI changed nothing in the change, so Local CI does not run it again: the pull request opens, and CI judges it against main.\"; exit 0; }; wt=\"$(cast ws path $worktree)\" && cd \"$wt\" && grep -q -- --budget scripts/ci/local.ts || { echo \"Local CI did not run: the run has no worktree, or this change predates scripts/ci/local.ts --budget. CI judges the change.\"; exit 0; }; _head=\"$(git rev-parse HEAD)\"; [ \"$(gh run list --commit \"$_head\" --limit 50 --json event,status,conclusion -q '[.[] | select(.event == \"pull_request\" or .event == \"push\")] | if length > 0 and all(.status == \"completed\" and (.conclusion == \"success\" or .conclusion == \"skipped\" or .conclusion == \"neutral\")) then \"green\" else \"\" end' 2>/dev/null)\" = green ] && { echo \"GitHub CI already passed on the change's head ${_head:0:10}, so Local CI does not run it again.\"; exit 0; }; rm -f \"$run_dir/local-ci.json\"; _base=$diff_base; bun scripts/ci/local.ts --no-typecheck --committed --base \"${_base:-origin/$default_branch}\" --budget 15 --json \"$run_dir/local-ci.json\"; lc_exit=$?; [ $lc_exit -eq 1 ] && [ ! -s \"$run_dir/local-ci.json\" ] && echo \"No verdict: local.ts exited 1 without writing its result, so it crashed.\" && lc_exit=2; case \"$local_ci_fix.visits\" in [1-9]*) [ $lc_exit -eq 1 ] && echo \"Still red after the session's turn on it: the pull request opens, and CI judges it against main.\" && { [ -z \"$CAST_STATION_OUTCOME\" ] || echo carried > \"$CAST_STATION_OUTCOME\"; } && lc_exit=0;; esac; [ $lc_exit -ne 1 ]", timeout=1800, fix="local_ci_fix", machine_slot="local_ci", no_slot="pr"]
  // no_slot="pr": a run that waited its whole timeout for one of the machine's Local CI places goes on without it, and CI
  // judges the change. An attribute, since a station placed with before= writes no edges, and a cast that predates
  // machine slots ignores both attributes and runs Local CI as before.
  // Local CI's own way back: the Fix findings brief reads CI's and the reviewer's verdicts, which do not exist yet here.
  // It sends a change back once per run; red again, it goes on to CI, which tells the change's failures from main's.
  // Back from a fix that changed nothing (every failure main's, or none the session's), Local CI passes at once: the
  // same change would only fail the same way again, and whatever follows Local CI's pass still runs. So it does on a
  // head GitHub's CI already passed (a round back from the PR), which only repeats a verdict CI gave. Still red after
  // the fix, it goes on to the PR and records its outcome as carried (contracts/stationOutcome.ts), not a pass.
  local_ci_fix [label="Fix Local CI", backend=subject, max_visits=3, prompt="@change/local_ci_fix.md"]
  local_ci_fix -> local_ci
}
