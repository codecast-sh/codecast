# Convex backend URL
VITE_CONVEX_URL=https://your-convex-instance.example.com

# GitHub App (optional - for PR integration)
VITE_GITHUB_APP_SLUG=your-github-app-slug

# Analytics (optional)
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Ads conversion measurement (optional). One value, exactly as Google's
# event snippet prints it: "AW-<tag id>/<conversion label>". Unset means no ad
# tag loads and no conversion is reported. Codecast's is conversion action
# 7758067566 in customer 6957561342; see ledger ct-41655.
VITE_GOOGLE_ADS_SEND_TO=

# Sentry source map upload (optional, build-time only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Server
PORT=3000
