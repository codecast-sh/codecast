{
  "nodes": [
    {
      "id": "start",
      "label": "start",
      "shape": "Mdiamond",
      "type": "start"
    },
    {
      "id": "pr",
      "label": "PR",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 600
    },
    {
      "id": "checks",
      "label": "CI and review",
      "shape": "component",
      "type": "parallel_fanout"
    },
    {
      "id": "ci",
      "label": "CI",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 5400
    },
    {
      "id": "review",
      "label": "Review",
      "shape": "box",
      "type": "agent",
      "backend": "session"
    },
    {
      "id": "joined",
      "label": "Both done",
      "shape": "tripleoctagon",
      "type": "parallel_fanin"
    },
    {
      "id": "verdicts",
      "label": "Verdicts",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 60,
      "fold": true
    },
    {
      "id": "merge",
      "label": "Merge",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 3600
    },
    {
      "id": "moved",
      "label": "Branch moved",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 60
    },
    {
      "id": "retest",
      "label": "Retest",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 120
    },
    {
      "id": "wait_main",
      "label": "Wait for green main",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 15000
    },
    {
      "id": "onto_main",
      "label": "Onto main",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 600
    },
    {
      "id": "ci_card",
      "label": "Why a person",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 120
    },
    {
      "id": "landed",
      "label": "Merged",
      "shape": "parallelogram",
      "type": "command",
      "timeout": 60,
      "fold": true
    },
    {
      "id": "exit",
      "label": "Live",
      "shape": "Msquare",
      "type": "exit"
    },
    {
      "id": "brief",
      "label": "Fix findings",
      "shape": "box",
      "type": "agent",
      "backend": "subject",
      "max_visits": 3
    },
    {
      "id": "ci_conflict",
      "label": "Resolve conflict",
      "shape": "box",
      "type": "agent",
      "backend": "subject",
      "max_visits": 3
    },
    {
      "id": "fix_conflict",
      "label": "Resolve conflict",
      "shape": "box",
      "type": "agent",
      "backend": "subject",
      "max_visits": 3
    },
    {
      "id": "nopr",
      "label": "No pull request",
      "shape": "Msquare",
      "type": "exit",
      "stop": "$pr.output"
    },
    {
      "id": "rejected",
      "label": "Rejected",
      "shape": "Msquare",
      "type": "exit",
      "stop": "The reviewer rejected the change: $verdicts.json.why"
    },
    {
      "id": "found",
      "label": "Found work",
      "shape": "Msquare",
      "type": "exit",
      "stop": "CI or the reviewer found work, and no session made this change to fix it: $verdicts.json.why"
    },
    {
      "id": "verdictless",
      "label": "No verdicts",
      "shape": "Msquare",
      "type": "exit",
      "stop": "Verdicts could not read the round. The change is not at fault: resume this run at PR (`cast workflow resume $task_id --at pr`) to run CI and a fresh review on the same change once that is fixed. Verdicts said: $verdicts.output",
      "machine": true
    },
    {
      "id": "unreviewed",
      "label": "Review never finished",
      "shape": "Msquare",
      "type": "exit",
      "stop": "The review never finished, also when asked again. The change is not at fault: resume this run at PR (`cast workflow resume $task_id --at pr`) to run CI and a fresh review on the same change. What stopped it: $last_error",
      "machine": true
    },
    {
      "id": "noci",
      "label": "CI never reported",
      "shape": "Msquare",
      "type": "exit",
      "stop": "CI never reported on the pushed head, also after running it again. The change is not at fault: resume this run at PR (`cast workflow resume $task_id --at pr`) to run CI and a fresh review on the same change once GitHub runs CI on pull requests again. What CI said: $verdicts.json.why",
      "machine": true
    },
    {
      "id": "moving",
      "label": "Main keeps moving",
      "shape": "Msquare",
      "type": "exit",
      "stop": "Main keeps moving under this change: CI ran again 3 times and main moved again each time. When main is quieter, resume this run at PR (`cast workflow resume $task_id --at pr`) to run CI and a fresh review on the same change. Merge said: $merge.output"
    },
    {
      "id": "lost",
      "label": "Pull request lost",
      "shape": "Msquare",
      "type": "exit",
      "stop": "$retest.output"
    },
    {
      "id": "moving_branch",
      "label": "Branch keeps moving",
      "shape": "Msquare",
      "type": "exit",
      "stop": "The branch keeps moving: 3 pushes during review or CI, and a 4th: $verdicts.json.why"
    },
    {
      "id": "mainred",
      "label": "Main stayed red",
      "shape": "Msquare",
      "type": "exit",
      "stop": "Main's CI did not go green while this change waited for it, so the change's failures could not be told from main's. Once main is green, resume this run at PR (`cast workflow resume $task_id --at pr`) to run CI and a fresh review on the same change. $wait_main.output"
    },
    {
      "id": "mainred_again",
      "label": "Main stayed red",
      "shape": "Msquare",
      "type": "exit",
      "stop": "Main CI went red under this change again after two waits for it, so the change's failures could not be told from main's. Once main is green, resume this run at PR (`cast workflow resume $task_id --at pr`) to run CI and a fresh review on the same change. What CI said: $verdicts.json.why"
    },
    {
      "id": "unrebased",
      "label": "Not onto main",
      "shape": "Msquare",
      "type": "exit",
      "stop": "$onto_main.output"
    },
    {
      "id": "nobody",
      "label": "Needs a person",
      "shape": "Msquare",
      "type": "exit",
      "stop": "This change edits CI, so CI can't vouch for it, and no session is behind the run to take it to a person."
    },
    {
      "id": "dropped",
      "label": "Dropped",
      "shape": "Msquare",
      "type": "exit",
      "stop": "$stop_reason"
    },
    {
      "id": "unshipped",
      "label": "Not merged",
      "shape": "Msquare",
      "type": "exit",
      "stop": "$merge.output"
    },
    {
      "id": "direct_review",
      "label": "Review",
      "shape": "box",
      "type": "agent",
      "backend": "session"
    },
    {
      "id": "direct_fix",
      "label": "Fix findings",
      "shape": "box",
      "type": "agent",
      "backend": "subject",
      "max_visits": 3
    },
    {
      "id": "direct_revise",
      "label": "Fix findings",
      "shape": "box",
      "type": "agent",
      "backend": "subject",
      "max_visits": 3
    },
    {
      "id": "direct_conflict",
      "label": "Resolve conflict",
      "shape": "box",
      "type": "agent",
      "backend": "subject",
      "max_visits": 3
    },
    {
      "id": "direct_ci_red",
      "label": "Fix CI",
      "shape": "box",
      "type": "agent",
      "backend": "subject",
      "max_visits": 3
    },
    {
      "id": "direct_rejected",
      "label": "Rejected",
      "shape": "Msquare",
      "type": "exit",
      "stop": "The reviewer rejected the change. $review_note"
    },
    {
      "id": "direct_changes",
      "label": "Found work",
      "shape": "Msquare",
      "type": "exit",
      "stop": "The reviewer asked for changes, and no session made this change to fix them. $review_note"
    },
    {
      "id": "direct_unreviewed",
      "label": "No verdict",
      "shape": "Msquare",
      "type": "exit",
      "stop": "The reviewer ended its turn without a verdict on the change.",
      "machine": true
    },
    {
      "id": "decide__decide",
      "label": "Decide",
      "shape": "hexagon",
      "type": "human",
      "segment": "decide",
      "segment_flow": "decide",
      "asks_if": "it edits CI"
    },
    {
      "id": "decide__ship",
      "label": "Approved",
      "shape": "parallelogram",
      "type": "command",
      "segment": "decide",
      "segment_flow": "decide",
      "segment_exit": "done"
    },
    {
      "id": "decide__revise",
      "label": "Revise",
      "shape": "parallelogram",
      "type": "command",
      "segment": "decide",
      "segment_flow": "decide",
      "segment_exit": "stop",
      "stop": "Sent back for revision. $human_message"
    },
    {
      "id": "decide__dropped",
      "label": "Dropped",
      "shape": "parallelogram",
      "type": "command",
      "segment": "decide",
      "segment_flow": "decide",
      "segment_exit": "stop",
      "stop": "Dropped at the gate. $human_message"
    },
    {
      "id": "decide",
      "label": "Decide",
      "shape": "diamond",
      "type": "conditional",
      "segment": "decide",
      "segment_flow": "decide",
      "segment_entry": true
    },
    {
      "id": "deploy__wait",
      "label": "Go live",
      "shape": "parallelogram",
      "type": "command",
      "segment": "deploy",
      "segment_flow": "deploy",
      "timeout": 90900
    },
    {
      "id": "deploy__live",
      "label": "Live",
      "shape": "parallelogram",
      "type": "command",
      "segment": "deploy",
      "segment_flow": "deploy",
      "segment_exit": "done"
    },
    {
      "id": "deploy__unmerged",
      "label": "Not merged",
      "shape": "Msquare",
      "type": "exit",
      "segment": "deploy",
      "segment_flow": "deploy",
      "stop": "$deploy__wait.output"
    },
    {
      "id": "deploy__stuck",
      "label": "Deploy stuck",
      "shape": "Msquare",
      "type": "exit",
      "segment": "deploy",
      "segment_flow": "deploy",
      "stop": "$deploy__wait.output"
    },
    {
      "id": "deploy__failed",
      "label": "Deploy failed",
      "shape": "Msquare",
      "type": "exit",
      "segment": "deploy",
      "segment_flow": "deploy",
      "stop": "$deploy__wait.output"
    },
    {
      "id": "deploy",
      "label": "Deploy",
      "shape": "diamond",
      "type": "conditional",
      "segment": "deploy",
      "segment_flow": "deploy",
      "segment_entry": true
    },
    {
      "id": "direct_check__verify",
      "label": "Verify",
      "shape": "parallelogram",
      "type": "command",
      "segment": "direct_check",
      "segment_flow": "check",
      "timeout": 3600
    },
    {
      "id": "direct_check__passed",
      "label": "Passed",
      "shape": "parallelogram",
      "type": "command",
      "segment": "direct_check",
      "segment_flow": "check",
      "segment_exit": "done"
    },
    {
      "id": "direct_check__failed",
      "label": "Checks failed",
      "shape": "parallelogram",
      "type": "command",
      "segment": "direct_check",
      "segment_flow": "check",
      "segment_exit": "stop",
      "stop": "The project's check failed on the change: $direct_check__verify.summary"
    },
    {
      "id": "direct_check__unjudged",
      "label": "Not checked here",
      "shape": "parallelogram",
      "type": "command",
      "segment": "direct_check",
      "segment_flow": "check",
      "segment_exit": "stop",
      "stop": "This machine could not run the project's check, so the change is not judged yet: $direct_check__verify.summary. Fix the machine, or run the flow again on one that can."
    },
    {
      "id": "direct_check__nocheck",
      "label": "No check command",
      "shape": "parallelogram",
      "type": "command",
      "segment": "direct_check",
      "segment_flow": "check",
      "segment_exit": "stop",
      "stop": "This repository names no check command, so nothing can check the change: set [line.commands] check in .codecast/line.toml on its default branch."
    },
    {
      "id": "direct_check",
      "label": "Check",
      "shape": "diamond",
      "type": "conditional",
      "segment": "direct_check",
      "segment_flow": "check",
      "segment_entry": true
    },
    {
      "id": "land__rebase",
      "label": "Rebase",
      "shape": "parallelogram",
      "type": "command",
      "segment": "land",
      "segment_flow": "ship",
      "max_visits": 3,
      "timeout": 3600
    },
    {
      "id": "land__ship",
      "label": "Land",
      "shape": "parallelogram",
      "type": "command",
      "segment": "land",
      "segment_flow": "ship",
      "timeout": 4500
    },
    {
      "id": "land__shipped",
      "label": "Merged",
      "shape": "parallelogram",
      "type": "command",
      "segment": "land",
      "segment_flow": "ship",
      "segment_exit": "done"
    },
    {
      "id": "land__landed",
      "label": "Already merged",
      "shape": "parallelogram",
      "type": "command",
      "segment": "land",
      "segment_flow": "ship",
      "segment_exit": "done"
    },
    {
      "id": "land__conflict",
      "label": "Conflict",
      "shape": "parallelogram",
      "type": "command",
      "segment": "land",
      "segment_flow": "ship",
      "segment_exit": "stop",
      "stop": "The change does not rebase cleanly or fails the check on the default branch. $land__rebase.output"
    },
    {
      "id": "land__unshipped",
      "label": "Not merged",
      "shape": "parallelogram",
      "type": "command",
      "segment": "land",
      "segment_flow": "ship",
      "segment_exit": "stop",
      "stop": "The change was not merged. $land__ship.output"
    },
    {
      "id": "land",
      "label": "Land",
      "shape": "diamond",
      "type": "conditional",
      "segment": "land",
      "segment_flow": "ship",
      "segment_entry": true
    },
    {
      "id": "direct_deploy__wait",
      "label": "Go live",
      "shape": "parallelogram",
      "type": "command",
      "segment": "direct_deploy",
      "segment_flow": "deploy",
      "timeout": 90900
    },
    {
      "id": "direct_deploy__live",
      "label": "Live",
      "shape": "parallelogram",
      "type": "command",
      "segment": "direct_deploy",
      "segment_flow": "deploy",
      "segment_exit": "done"
    },
    {
      "id": "direct_deploy__unmerged",
      "label": "Not merged",
      "shape": "Msquare",
      "type": "exit",
      "segment": "direct_deploy",
      "segment_flow": "deploy",
      "stop": "$direct_deploy__wait.output"
    },
    {
      "id": "direct_deploy__stuck",
      "label": "Deploy stuck",
      "shape": "Msquare",
      "type": "exit",
      "segment": "direct_deploy",
      "segment_flow": "deploy",
      "stop": "$direct_deploy__wait.output"
    },
    {
      "id": "direct_deploy__failed",
      "label": "Deploy failed",
      "shape": "Msquare",
      "type": "exit",
      "segment": "direct_deploy",
      "segment_flow": "deploy",
      "stop": "$direct_deploy__wait.output"
    },
    {
      "id": "direct_deploy",
      "label": "Deploy",
      "shape": "diamond",
      "type": "conditional",
      "segment": "direct_deploy",
      "segment_flow": "deploy",
      "segment_entry": true
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "pr"
    },
    {
      "from": "pr",
      "to": "checks",
      "condition": "outcome = success"
    },
    {
      "from": "pr",
      "to": "nopr",
      "label": "no pull request",
      "condition": "outcome = failure"
    },
    {
      "from": "checks",
      "to": "ci"
    },
    {
      "from": "checks",
      "to": "review",
      "condition": "not pr.json.reviewed.verdict"
    },
    {
      "from": "ci",
      "to": "joined",
      "condition": "outcome = success"
    },
    {
      "from": "ci",
      "to": "verdicts",
      "condition": "outcome = failure"
    },
    {
      "from": "review",
      "to": "joined",
      "condition": "outcome = success"
    },
    {
      "from": "review",
      "to": "unreviewed",
      "label": "review never finished",
      "condition": "outcome = failure"
    },
    {
      "from": "joined",
      "to": "verdicts",
      "condition": "outcome = failure"
    },
    {
      "from": "joined",
      "to": "verdicts"
    },
    {
      "from": "verdicts",
      "to": "moved",
      "label": "pushed after this round",
      "condition": "verdicts.json.next = new_round and moved.visits < 3"
    },
    {
      "from": "verdicts",
      "to": "moving_branch",
      "label": "branch keeps moving",
      "condition": "verdicts.json.next = new_round"
    },
    {
      "from": "verdicts",
      "to": "merge",
      "condition": "verdicts.json.next = merge"
    },
    {
      "from": "verdicts",
      "to": "rejected",
      "label": "rejected",
      "condition": "verdicts.json.next = rejected"
    },
    {
      "from": "verdicts",
      "to": "ci",
      "label": "CI never reported",
      "condition": "verdicts.json.next = rerun_ci"
    },
    {
      "from": "verdicts",
      "to": "review",
      "label": "no verdict this round",
      "condition": "verdicts.json.next = rerun_review"
    },
    {
      "from": "verdicts",
      "to": "noci",
      "label": "CI never reported again",
      "condition": "verdicts.json.next = no_ci"
    },
    {
      "from": "verdicts",
      "to": "wait_main",
      "label": "every failure is main's",
      "condition": "verdicts.json.next = wait_main and wait_main.visits < 2"
    },
    {
      "from": "verdicts",
      "to": "mainred_again",
      "label": "main red again",
      "condition": "verdicts.json.next = wait_main"
    },
    {
      "from": "verdicts",
      "to": "ci_card",
      "label": "it edits CI",
      "condition": "verdicts.json.next = decide and change_conversation"
    },
    {
      "from": "verdicts",
      "to": "nobody",
      "label": "it edits CI, no session",
      "condition": "verdicts.json.next = decide"
    },
    {
      "from": "verdicts",
      "to": "found",
      "label": "found work, no session",
      "condition": "(verdicts.json.next = brief or verdicts.json.next = conflict) and not change_conversation"
    },
    {
      "from": "verdicts",
      "to": "ci_conflict",
      "label": "conflicts with main",
      "condition": "verdicts.json.next = conflict"
    },
    {
      "from": "verdicts",
      "to": "brief",
      "label": "CI red or changes asked",
      "condition": "verdicts.json.next = brief and verdicts.json.fix = true"
    },
    {
      "from": "verdicts",
      "to": "brief",
      "label": "no verdict, or only small findings",
      "condition": "verdicts.json.next = brief"
    },
    {
      "from": "verdicts",
      "to": "verdictless",
      "label": "no verdicts"
    },
    {
      "from": "merge",
      "to": "landed",
      "condition": "outcome = success and merge.json.sha"
    },
    {
      "from": "merge",
      "to": "fix_conflict",
      "label": "conflict",
      "condition": "outcome = failure and merge.exit_code = 1 and (merge.output contains \" conflicts with \" or merge.output contains \"rebuild the change on\") and change_conversation"
    },
    {
      "from": "merge",
      "to": "retest",
      "label": "retest",
      "condition": "outcome = failure and merge.exit_code = 3 and retest.visits < 3"
    },
    {
      "from": "merge",
      "to": "moving",
      "label": "main keeps moving",
      "condition": "outcome = failure and merge.exit_code = 3"
    },
    {
      "from": "merge",
      "to": "unshipped",
      "label": "not merged"
    },
    {
      "from": "retest",
      "to": "ci",
      "condition": "outcome = success"
    },
    {
      "from": "retest",
      "to": "pr",
      "label": "pushed after review",
      "condition": "outcome = failure and retest.exit_code = 4"
    },
    {
      "from": "retest",
      "to": "lost",
      "condition": "outcome = failure"
    },
    {
      "from": "wait_main",
      "to": "onto_main",
      "condition": "outcome = success"
    },
    {
      "from": "wait_main",
      "to": "mainred",
      "label": "main stayed red",
      "condition": "outcome = failure"
    },
    {
      "from": "onto_main",
      "to": "ci",
      "condition": "outcome = success"
    },
    {
      "from": "onto_main",
      "to": "pr",
      "label": "pushed after review",
      "condition": "outcome = failure and onto_main.exit_code = 4"
    },
    {
      "from": "onto_main",
      "to": "unrebased",
      "label": "not onto main",
      "condition": "outcome = failure"
    },
    {
      "from": "ci_card",
      "to": "decide"
    },
    {
      "from": "landed",
      "to": "deploy"
    },
    {
      "from": "start",
      "to": "direct_check",
      "label": "straight to main",
      "condition": "ship_mode = direct"
    },
    {
      "from": "direct_review",
      "to": "land",
      "condition": "review_verdict = approve"
    },
    {
      "from": "direct_review",
      "to": "direct_revise",
      "label": "changes asked",
      "condition": "review_verdict = changes and change_conversation"
    },
    {
      "from": "direct_review",
      "to": "direct_changes",
      "label": "changes asked, no session",
      "condition": "review_verdict = changes"
    },
    {
      "from": "direct_review",
      "to": "direct_rejected",
      "label": "rejected",
      "condition": "review_verdict = reject"
    },
    {
      "from": "direct_review",
      "to": "direct_unreviewed",
      "label": "no verdict"
    },
    {
      "from": "direct_fix",
      "to": "direct_check"
    },
    {
      "from": "direct_revise",
      "to": "direct_check"
    },
    {
      "from": "direct_conflict",
      "to": "direct_check"
    },
    {
      "from": "direct_ci_red",
      "to": "direct_check"
    },
    {
      "from": "brief",
      "to": "pr"
    },
    {
      "from": "fix_conflict",
      "to": "pr"
    },
    {
      "from": "ci_conflict",
      "to": "pr"
    },
    {
      "from": "moved",
      "to": "pr"
    },
    {
      "from": "decide__ship",
      "to": "merge"
    },
    {
      "from": "decide__revise",
      "to": "brief",
      "label": "revise",
      "condition": "outcome = failure and decide__revise.json.exit = revise"
    },
    {
      "from": "decide__revise",
      "to": "dropped",
      "label": "dropped",
      "condition": "outcome = failure and decide__revise.json.exit = dropped"
    },
    {
      "from": "decide__dropped",
      "to": "brief",
      "label": "revise",
      "condition": "outcome = failure and decide__dropped.json.exit = revise"
    },
    {
      "from": "decide__dropped",
      "to": "dropped",
      "label": "dropped",
      "condition": "outcome = failure and decide__dropped.json.exit = dropped"
    },
    {
      "from": "decide",
      "to": "decide__decide"
    },
    {
      "from": "decide__decide",
      "to": "decide__ship",
      "label": "[S] Approve merge :: Merges it; it goes live with the next deploy"
    },
    {
      "from": "decide__decide",
      "to": "decide__revise",
      "label": "[R] Revise :: Your note goes to the session that made it; the change comes back through review"
    },
    {
      "from": "decide__decide",
      "to": "decide__dropped",
      "label": "[D] Drop :: Closes it without merging; the session hears your reason"
    },
    {
      "from": "deploy__live",
      "to": "exit"
    },
    {
      "from": "deploy",
      "to": "deploy__wait"
    },
    {
      "from": "deploy__wait",
      "to": "deploy__live",
      "condition": "outcome = success"
    },
    {
      "from": "deploy__wait",
      "to": "deploy__unmerged",
      "condition": "outcome = failure and deploy__wait.exit_code = 4"
    },
    {
      "from": "deploy__wait",
      "to": "deploy__stuck",
      "condition": "outcome = failure and deploy__wait.exit_code = 5"
    },
    {
      "from": "deploy__wait",
      "to": "deploy__failed",
      "condition": "outcome = failure and deploy__wait.exit_code != 4 and deploy__wait.exit_code != 5"
    },
    {
      "from": "direct_check__passed",
      "to": "direct_review",
      "condition": "outcome = success"
    },
    {
      "from": "direct_check__failed",
      "to": "direct_fix",
      "label": "check failed",
      "condition": "outcome = failure and direct_check__failed.json.exit = failed and change_conversation"
    },
    {
      "from": "direct_check__unjudged",
      "to": "direct_fix",
      "label": "check failed",
      "condition": "outcome = failure and direct_check__unjudged.json.exit = failed and change_conversation"
    },
    {
      "from": "direct_check__nocheck",
      "to": "direct_fix",
      "label": "check failed",
      "condition": "outcome = failure and direct_check__nocheck.json.exit = failed and change_conversation"
    },
    {
      "from": "direct_check",
      "to": "direct_check__verify"
    },
    {
      "from": "direct_check__verify",
      "to": "direct_check__passed",
      "condition": "outcome = success"
    },
    {
      "from": "direct_check__verify",
      "to": "direct_check__nocheck",
      "condition": "outcome = failure and not line.commands.check"
    },
    {
      "from": "direct_check__verify",
      "to": "direct_check__failed",
      "condition": "outcome = failure and direct_check__verify.exit_code != 2 and line.commands.check"
    },
    {
      "from": "direct_check__verify",
      "to": "direct_check__unjudged",
      "condition": "outcome = failure and direct_check__verify.exit_code = 2 and line.commands.check"
    },
    {
      "from": "land__shipped",
      "to": "direct_deploy",
      "condition": "outcome = success"
    },
    {
      "from": "land__landed",
      "to": "direct_deploy",
      "condition": "outcome = success"
    },
    {
      "from": "land__conflict",
      "to": "direct_conflict",
      "label": "conflicts with main",
      "condition": "outcome = failure and land__conflict.json.exit = conflict and change_conversation"
    },
    {
      "from": "land__conflict",
      "to": "direct_ci_red",
      "label": "CI red after landing",
      "condition": "outcome = failure and land__conflict.json.exit = unshipped and land__ship.exit_code = 7 and change_conversation"
    },
    {
      "from": "land__unshipped",
      "to": "direct_conflict",
      "label": "conflicts with main",
      "condition": "outcome = failure and land__unshipped.json.exit = conflict and change_conversation"
    },
    {
      "from": "land__unshipped",
      "to": "direct_ci_red",
      "label": "CI red after landing",
      "condition": "outcome = failure and land__unshipped.json.exit = unshipped and land__ship.exit_code = 7 and change_conversation"
    },
    {
      "from": "land",
      "to": "land__rebase"
    },
    {
      "from": "land__rebase",
      "to": "land__ship",
      "condition": "outcome = success and land__rebase.json.landed != true"
    },
    {
      "from": "land__rebase",
      "to": "land__landed",
      "condition": "outcome = success and land__rebase.json.landed = true"
    },
    {
      "from": "land__rebase",
      "to": "land__conflict",
      "condition": "outcome = failure and land__rebase.exit_code = 1"
    },
    {
      "from": "land__rebase",
      "to": "land__ship",
      "condition": "outcome = failure and land__rebase.exit_code != 1"
    },
    {
      "from": "land__ship",
      "to": "land__shipped",
      "condition": "outcome = success"
    },
    {
      "from": "land__ship",
      "to": "land__rebase",
      "label": "default branch moved",
      "condition": "outcome = failure and land__ship.exit_code = 3"
    },
    {
      "from": "land__ship",
      "to": "land__unshipped",
      "condition": "outcome = failure and land__ship.exit_code != 3"
    },
    {
      "from": "direct_deploy__live",
      "to": "exit"
    },
    {
      "from": "direct_deploy",
      "to": "direct_deploy__wait"
    },
    {
      "from": "direct_deploy__wait",
      "to": "direct_deploy__live",
      "condition": "outcome = success"
    },
    {
      "from": "direct_deploy__wait",
      "to": "direct_deploy__unmerged",
      "condition": "outcome = failure and direct_deploy__wait.exit_code = 4"
    },
    {
      "from": "direct_deploy__wait",
      "to": "direct_deploy__stuck",
      "condition": "outcome = failure and direct_deploy__wait.exit_code = 5"
    },
    {
      "from": "direct_deploy__wait",
      "to": "direct_deploy__failed",
      "condition": "outcome = failure and direct_deploy__wait.exit_code != 4 and direct_deploy__wait.exit_code != 5"
    }
  ]
}
