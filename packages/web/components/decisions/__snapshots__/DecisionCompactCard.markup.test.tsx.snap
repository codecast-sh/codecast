exports[`DecisionCompactCard unknown session 1`] = `"<div data-decision-card="hero-dec10" class="decision-card rounded-lg border bg-sol-card/40 transition-colors border-sol-border/70 hover:border-sol-border"><div class="px-4 pt-3 pb-2"><div class="flex items-start gap-2"><div class="cc-seprow flex-1 min-w-0 text-[11px] text-sol-text-dim"><div class="cc-seprow-inner"><span class="cc-seprow-item"><span class="cc-sep" aria-hidden="true"></span><span class="cc-seprow-body items-center gap-2"><span class="w-1.5 h-1.5 shrink-0 rounded-full bg-sol-yellow animate-pulse" title="Blocking: the session is parked" aria-label="blocking"></span><span class="inline-flex items-center gap-1.5 min-w-0 max-w-[22rem]" data-asking-session="hero-cx"><span class="w-1.5 h-1.5 shrink-0 rounded-full bg-sol-text-dim" title="The asking session is idle" aria-label="idle"></span><a class="truncate text-sol-text-muted hover:text-sol-blue transition-colors" title="Fallback title: go to the ask in the conversation" href="/conversation/hero-cx" data-discover="true">Fallback title</a></span></span></span><span class="cc-seprow-item"><span class="cc-sep" aria-hidden="true">·</span><span class="cc-seprow-body cc-nowrap">asked 12m</span></span><span class="cc-seprow-item"><span class="cc-sep" aria-hidden="true"></span><span class="cc-seprow-body flex-wrap items-center gap-2 min-w-0"></span></span><span class="cc-seprow-item is-end"><span class="cc-sep" aria-hidden="true"></span><span class="cc-seprow-body "><a class="group/open flex items-center gap-1 font-mono text-[11px] text-sol-text-dim hover:text-sol-text focus-visible:text-sol-text" href="/decisions/hero-dec10" data-discover="true">open<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right w-3 h-3" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></a></span></span></div></div></div><a class="decision-question block mt-2 text-sol-text hover:text-sol-blue transition-colors" href="/decisions/hero-dec10" data-discover="true">Ship the retry ladder behind a flag or straight to everyone?</a></div><div class="px-4 pb-3"><div><div class="space-y-2"><div class="space-y-1.5" data-option-list="true"><button type="button" class="decision-option w-full flex items-start gap-3 rounded-lg border transition-colors px-3 py-2 border-sol-yellow/50 hover:bg-sol-yellow/10 hover:border-sol-yellow" data-option="0"><span data-cc-option-number="" class="shrink-0 mt-[3px]"><span class="flex items-center justify-center rounded-full border font-mono text-sol-text-dim w-5 h-5 text-[10px] border-sol-border">1</span></span><span class="min-w-0 flex-1 text-left [overflow-wrap:anywhere]"><span class="flex items-center gap-2 flex-wrap"><span class="text-[13px] leading-snug text-sol-text">Behind a flag</span></span></span></button><button type="button" class="decision-option w-full flex items-start gap-3 rounded-lg border transition-colors px-3 py-2 border-sol-border/70 hover:bg-sol-card hover:border-sol-text-dim" data-option="1"><span data-cc-option-number="" class="shrink-0 mt-[3px]"><span class="flex items-center justify-center rounded-full border font-mono text-sol-text-dim w-5 h-5 text-[10px] border-sol-border">2</span></span><span class="min-w-0 flex-1 text-left [overflow-wrap:anywhere]"><span class="flex items-center gap-2 flex-wrap"><span class="text-[13px] leading-snug text-sol-text">Everyone</span></span></span></button></div><button type="button" class="flex items-center gap-1.5 text-[12px] text-sol-text-dim hover:text-sol-text transition-colors"><span>Or answer in your own words</span></button></div><div class="mt-3 flex items-center gap-4"><button class="flex items-center gap-1.5 text-[11px] text-sol-text-dim hover:text-sol-red transition-colors" title="Dismiss without answering — the agent is not told"><span>Dismiss</span></button></div></div></div><div class="px-4 pb-3"><section class="decision-discussion" data-decision-discussion="true"><div class="flex items-center gap-3"><button type="button" class="inline-flex items-center gap-1.5 rounded-md px-1.5 py-0.5 -ml-1.5 text-[12.5px] text-sol-text-muted hover:text-sol-text hover:bg-sol-bg-alt disabled:opacity-50 transition-colors" data-discuss-button="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square h-3.5 w-3.5" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path></svg>Discuss</button></div></section></div></div>"`;
