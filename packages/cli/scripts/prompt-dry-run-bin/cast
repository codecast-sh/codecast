#!/usr/bin/env bash
# `cast` for a prompt dry run (scripts/prompt-dry-run.ts puts this directory
# first on the run's PATH). Every call is logged to $RUN_DIR/calls.log. Reads
# pass through to the real CLI with the real state directory restored; anything
# that writes, posts, sends, pins or could start a session is refused with a
# line that says so, so a run can never reach a person's inbox. A harness that
# needs other fixtures puts its own `cast` in a directory and passes --guard.
#
# With DRY_RUN_SERVE_DIR set, reads answer from a saved world instead:
#  - `cast org inputs|health|ls` from org-inputs.json, org-health.json and
#    org-ls.json in it (the layout older served dirs have);
#  - any argv from reads/<key>.out, exit code from reads/<key>.exit (0 when
#    absent). The key is the sha256 of each argument followed by \x1f, the same
#    key packages/evals/src/served.ts computes when it captures the reads;
#  - an argv with no capture of its own, from the longest leading part of it
#    filed with a `.prefix` marker beside its `.out`: a synthetic world marks
#    `read <id>` that way, so `cast read <id> --full` or `--ask "..."` answers
#    with the transcript the world holds rather than failing. The marker holds
#    the argv its key was made from, so the match is a string compare and no
#    call hashes more than its own argv;
#  - a read whose first word, or first two words, is a line of `frozen` and
#    was not captured is refused, so a replay never reads the live workspace
#    for something its snapshot was meant to hold. A `*` line freezes every
#    read: a synthetic world answers from its record or not at all.
#
# `--help` before any `--` prints the CLI's own text, never the workspace, so
# it is never frozen or refused. It runs as the leading command words alone
# with one standalone --help after them, so a --help commander would take as
# an option's value never reaches an action, and with a state directory of
# its own, so no help call can sign in or reach anyone.
#
# calls.log gets the argv, then one marked line per outcome: SERVED (answered
# from the serve dir), UNSERVED (a frozen read with no capture), LIVE (passed
# to the real CLI, its output kept under live-reads/), HELP (the CLI's help text), UNKNOWN (a command the CLI does
# not have, answered here and run nowhere), REFUSED (a write). The eval gates
# read these marks.
#
# calls.log keeps each argv shell-quoted: an argument that is not a plain word
# is single-quoted ('it'\''s' for a quote inside), so a line splits back into
# the arguments it was (packages/evals/src/served.ts loggedArgv).
#
# With DRY_RUN_CLASSIFY set, the guard only says what it would make of the
# argv: it prints `read` or `write`, logs nothing and runs nothing. The eval
# gates ask it this way, so a REFUSED line in an old calls.log is judged by
# today's read list and a read once refused by mistake regrades on rescore.
set -u
LOG="${RUN_DIR:-$PWD}/calls.log"
ARGV="$*"
logged_argv() {
  local a q="'\\''" out=()
  for a in "$@"; do
    if [[ "$a" =~ ^[A-Za-z0-9_./:=@%+,-]+$ ]]; then out+=("$a"); else out+=("'${a//\'/$q}'"); fi
  done
  printf '%s' "${out[*]-}"
}
LOGGED="$(logged_argv "$@")"
CLASSIFY="${DRY_RUN_CLASSIFY:-}"
# Set when the harness's broker runs a live read this guard already logged.
LIVE_READ="${DRY_RUN_LIVE_READ:-}"
[ -n "$CLASSIFY" ] || [ -n "$LIVE_READ" ] || printf '%s\n' "$LOGGED" >> "$LOG"
SERVE="${DRY_RUN_SERVE_DIR:-}"
[ -z "$CLASSIFY" ] || SERVE=""
mark() { printf '%s %s\n' "$1" "$LOGGED" >> "$LOG"; }

serve_file() {
  [ -n "$SERVE" ] && [ -f "$SERVE/$1" ] || return 0
  mark SERVED; cat "$SERVE/$1"; exit 0
}
case "${1:-} ${2:-}" in
  "org inputs"*) serve_file org-inputs.json ;;
  "org health"*) serve_file org-health.json ;;
  "org ls"*|"org list"*) serve_file org-ls.json ;;
  "org proposals"*) mark SERVED; echo "No open proposals."; exit 0 ;;
esac

# The key a read is filed under, served or recorded live: sha256 of each
# argument followed by \x1f (packages/evals/src/served.ts servedReadKey).
read_key() {
  if command -v shasum >/dev/null 2>&1; then printf '%s\x1f' "$@" | shasum -a 256 | cut -d' ' -f1
  else printf '%s\x1f' "$@" | sha256sum | cut -d' ' -f1; fi
}

# serve_read <key>: answer from the read filed under that key, with its exit code.
serve_read() {
  local code=0
  mark SERVED
  cat "$SERVE/reads/$1.out"
  [ -f "$SERVE/reads/$1.exit" ] && code="$(tr -dc 0-9 < "$SERVE/reads/$1.exit")"
  exit "${code:-0}"
}
if [ -n "$SERVE" ] && [ $# -gt 0 ]; then
  key="$(read_key "$@")"
  [ -f "$SERVE/reads/$key.out" ] && serve_read "$key"
  printf -v joined '%s\x1f' "$@"
  best="" best_len=0
  for marker in "$SERVE"/reads/*.prefix; do
    [ -f "$marker" ] || continue
    pre=""; IFS= read -r -d '' pre < "$marker" || true
    [ -n "$pre" ] && [ "${#pre}" -gt "$best_len" ] && [ "${#pre}" -lt "${#joined}" ] && [[ "$joined" == "$pre"* ]] || continue
    best="${marker##*/}"; best="${best%.prefix}"; best_len=${#pre}
  done
  [ -n "$best" ] && [ -f "$SERVE/reads/$best.out" ] && serve_read "$best"
fi

# A read, by verb. `org review` prints the review prompt and only starts a
# session with --spawn.
# has_arg <word> <argv...>: the word is one of the arguments. Commander takes a
# subcommand after the parent's flags (`cast brief --team T edit -`), so a
# write word is looked for anywhere, not only second.
has_arg() { local w="$1" a; shift; for a in "$@"; do [ "$a" = "$w" ] && return 0; done; return 1; }
# has_flag <flag> <argv...>: the flag appears bare or as --flag=value, the two
# spellings Commander accepts, and any longer flag it begins (--resolve-all).
has_flag() { local f="$1" a; shift; for a in "$@"; do [[ "$a" == "$f"* ]] && return 0; done; return 1; }
is_read() {
  case "${1:-}" in
    task|project|plan|doc|initiative|trigger|anchor|role|org)
      case "${2:-}" in show|ls|context|wakes|grep|status|search|inputs|health|log|history|"") return 0 ;; esac
      # `plan replay` prints a plan's history; no other group has the verb.
      [ "${1:-}" = plan ] && [ "${2:-}" = replay ] && return 0
      [ "${1:-}" = org ] && [ "${2:-}" = review ] && ! has_arg --spawn "$@" ;;
    # `brief edit` writes a role's narrative and pins its standing session's state.
    brief) ! has_arg edit "$@" ;;
    # `call hold` changes a live huddle's delivery; `call snap` uploads frames.
    call) ! has_arg hold "$@" && ! has_arg snap "$@" ;;
    # `read --ack` clears the session's unread dot, so it writes. `read --ask`
    # answers a question about the session from its transcript: a server-side
    # model call, paid, that changes nothing, so it is a read (its cost is the
    # account's, not the rep's ledger's). A served world answers both from its
    # record, before this list is consulted.
    read) ! has_flag --ack "$@" ;;
    link|search|feed|sessions|diff|summary|calls|goals) return 0 ;;
    # A published page's reads; comments --resolve, set, rollback and rm write.
    publish) case "${2:-}" in ls|versions|viewers|links) return 0 ;; comments) ! has_flag --resolve "$@" ;; *) return 1 ;; esac ;;
    # A pull request's reads; comment, review, resolve, merge and close write.
    pr) case "${2:-}" in ls|show|events|threads) return 0 ;; *) return 1 ;; esac ;;
    # Team chat's reads; marking read is its own verb (/cli/chat/mark-read).
    chat) case "${2:-}" in read|thread|channels|ls|search) return 0 ;; *) return 1 ;; esac ;;
    # Only show and ls: a bare `cast decide "<question>"` posts a decision.
    decide) case "${2:-}" in show|ls) return 0 ;; *) return 1 ;; esac ;;
    # A decision stack's reads; create, add, remove, reorder, policy and delegate write.
    stack) case "${2:-}" in show|ls|list) return 0 ;; *) return 1 ;; esac ;;
    state) [ "${2:-}" = show ] ;;
    # A project's expectations; propose, apply and drop write. `routine` prints a pass.
    expectations) [ "${2:-}" = show ] || [ "${2:-}" = routine ] ;;
    # The line's reads (learning-loop.md LL4, LL7): the setup pass, the profile
    # unpublished, moments listed, the budget unset, and a judge's request
    # printed without sending (a sent try spends the team's budget).
    line) case "${2:-}" in
        judging) return 0 ;;
        profile) ! has_flag --publish "$@" ;;
        moments) [ "${3:-}" = ls ] || [ "${3:-}" = show ] ;;
        budget) ! has_flag --set "$@" ;;
        judges) [ "${3:-}" = try ] && has_flag --prompt "$@" ;;
        *) return 1 ;;
      esac ;;
    sources) case "${2:-}" in ls|show) return 0 ;; *) return 1 ;; esac ;;
    *) return 1 ;;
  esac
}
if [ -n "$CLASSIFY" ]; then if is_read "$@"; then echo read; else echo write; fi; exit 0; fi
frozen() {
  [ -n "$SERVE" ] && [ -f "$SERVE/frozen" ] || return 1
  grep -qxF -- '*' "$SERVE/frozen" || grep -qxF -- "${1:-}" "$SERVE/frozen" || grep -qxF -- "${1:-} ${2:-}" "$SERVE/frozen"
}
# The real CLI: the first `cast` on PATH that is not this guard.
real_bin() {
  local here; here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local dir
  # Process substitution, not a here-string: a here-string needs a temp file,
  # which the run's sandbox refuses.
  IFS=: read -ra dirs < <(printf '%s\n' "$PATH")
  for dir in "${dirs[@]}"; do [ "$dir" = "$here" ] && continue; [ -x "$dir/cast" ] && { printf '%s' "$dir/cast"; return 0; }; done
  echo "dry run: no real cast on PATH for a read" >&2; exit 1
}
# A read, run with the state directory the launching shell had (the run's own
# CODECAST_DIR is an empty directory on purpose). Its output and exit code are
# kept under $RUN_DIR/live-reads/<key>, the served-read layout, so a run that
# read the live workspace shows what it saw.
#
# Under prompt-dry-run.ts the agent's sandbox cannot read that state directory,
# so the read goes to the harness's broker (DRY_RUN_BROKER), which runs this
# guard again outside the sandbox with DRY_RUN_LIVE_READ set; that run
# classifies the argv on its own and writes the same live-reads files, which
# this side then answers from. With the harness gone the read reaches nothing.
real() {
  local bin dir key code
  dir="${RUN_DIR:-$PWD}/live-reads"; key="$(read_key "$@")"
  if [ -n "${DRY_RUN_BROKER:-}" ]; then
    mark LIVE
    rm -f "$dir/$key.out" "$dir/$key.exit"
    printf '%s\0' "$@" | curl -sS --max-time 900 --data-binary @- "$DRY_RUN_BROKER" >&2 \
      || { echo "dry run: the harness that runs this run's live reads is gone, so 'cast $ARGV' reaches nothing" >&2; exit 1; }
    [ -f "$dir/$key.exit" ] || exit 1
    cat "$dir/$key.out"
    exit "$(tr -dc 0-9 < "$dir/$key.exit")"
  fi
  bin="$(real_bin)" || exit 1
  [ -n "$LIVE_READ" ] || mark LIVE
  mkdir -p "$dir"
  if [ -n "${DRY_RUN_REAL_CODECAST_DIR:-}" ]; then CODECAST_DIR="$DRY_RUN_REAL_CODECAST_DIR" "$bin" "$@" > "$dir/$key.out"
  else env -u CODECAST_DIR "$bin" "$@" > "$dir/$key.out"; fi
  code=$?
  printf '%s\n' "$code" > "$dir/$key.exit"
  cat "$dir/$key.out"
  exit "$code"
}

# The CLI's help, under a state directory of its own so no help call can sign
# in or reach anyone. Only the given command words go through, then one --help
# of our own.
show_help() {
  local bin state; bin="$(real_bin)" || exit 1
  state="$(help_state)"
  mark HELP
  exec env CODECAST_DIR="$state" CODECAST_NO_AUTO_UPDATE=1 "$bin" "$@" --help
}
help_state() { local s="${RUN_DIR:-$PWD}/.cast-help"; mkdir -p "$s"; printf '%s' "$s"; }

# The leading command words: lowercase words, up to the first flag or other text.
command_words=()
for a in "$@"; do [[ "$a" =~ ^[a-z][a-z0-9-]*$ ]] || break; command_words+=("$a"); done

# Help: asked for when --help comes before any `--`. Only the leading command
# words go through, so a --help commander would take as an option's value
# never reaches an action.
wants_help() { local a; for a in "$@"; do [ "$a" = "--" ] && return 1; [ "$a" = "--help" ] && return 0; done; return 1; }
if wants_help "$@"; then show_help ${command_words[@]+"${command_words[@]}"}; fi

# The CLI's own command tree (`cast agent-context --json`), read once per run
# under the help state directory and kept beside it.
command_tree() {
  local state tree tmp bin
  state="$(help_state)"; tree="$state/agent-context.json"
  if [ ! -s "$tree" ]; then
    bin="$(real_bin)" || return 1
    tmp="$tree.$$"
    if env CODECAST_DIR="$state" CODECAST_NO_AUTO_UPDATE=1 "$bin" agent-context --json > "$tmp" 2>/dev/null; then mv "$tmp" "$tree"; else rm -f "$tmp"; return 1; fi
  fi
  printf '%s' "$tree"
}
# Not a command: the leading words leave the tree at a group that runs nothing
# for a word it has no subcommand for (`runsBare` false), or at the root
# (`cast ct show`). Commander answers such a group with "unknown command", and
# the root answers the same through the CLI's own failUnknownCommand, so
# nothing runs and it is no write. A group that does run something bare hands
# the word to it instead: `cast sync <word>` uploads conversations and
# `cast hosts <word>` reaches its default `ls`, so those stay refused. Prints
# the unknown word, a tab, and the group path. Without jq, or with a tree that
# lacks runsBare (an older CLI), nothing is unknown and the call is refused.
unknown_command() {
  [ ${#command_words[@]} -ge 1 ] && command -v jq >/dev/null 2>&1 || return 1
  local tree; tree="$(command_tree)" || return 1
  jq -er --args '
    . as $ctx
    | select(any(.commands[]; has("runsBare")))
    | reduce $ARGS.positional[] as $w ({path: [], node: null, word: null};
        if .word then . else
          .path as $p
          | ([$ctx.commands[] | select(.path[0:-1] == $p and (.path[-1] == $w or any(.aliases[]?; . == $w)))] | .[0]) as $hit
          | if $hit then .path = $hit.path | .node = $hit else .word = $w end
        end)
    | select(.word != null and (.node == null or ((.node.subcommands | length) > 0 and .node.runsBare == false)))
    | "\(.word)\t\(.path | join(" "))"
  ' "${command_words[@]}" < "$tree"
}

if is_read "$@"; then
  if frozen "$@"; then
    mark UNSERVED
    echo "dry run: 'cast $ARGV' is frozen for this replay and was not captured" >&2; exit 1
  fi
  real "$@"
fi
# An unknown word is answered here, as commander answers it, and the real CLI
# never sees these words. A pure group's `help` is commander's help command.
if hit="$(unknown_command)"; then
  word="${hit%%$'\t'*}"; group="${hit#*$'\t'}"
  if [ "$word" = help ] && [ -n "$group" ]; then show_help $group; fi
  mark UNKNOWN
  echo "error: unknown command '$word'" >&2
  echo "Run 'cast${group:+ $group} --help' for the list of commands." >&2
  exit 1
fi
mark REFUSED
case "${1:-}" in
  task|project|plan|doc|initiative|trigger|anchor|role|org) echo "dry run: 'cast $ARGV' would write, and is refused" >&2 ;;
  state) echo "dry run: cast state is refused" >&2 ;;
  read) echo "dry run: 'cast $ARGV' is refused: --ack marks the session read; read the session without it" >&2 ;;
  *) echo "dry run: 'cast $ARGV' is refused; write what you would post to the file the briefing names" >&2 ;;
esac
exit 1
