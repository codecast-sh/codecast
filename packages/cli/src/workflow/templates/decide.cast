// A segment (flows.md FL2): one question to the person who answers for the
// change, on the decision rail every gate uses (the-line.md L4).
digraph decide {
  // `question`: what the card asks, when the composing flow knows why it asks (the change flow: it edits CI); else the reviewer's.
  graph [kind="segment", label="Decide", description="The person who answers for the change says ship, revise or drop", takes="task", params="question=$review_question"]
  start [shape=Mdiamond]
  decide [label="Decide", shape=hexagon, category=review,
    prompt="$question",
    doc="$review_body"]
  ship    [shape=Msquare, label="Approved"]
  revise  [shape=Msquare, label="Revise", stop="Sent back for revision. $human_message"]
  dropped [shape=Msquare, label="Dropped", stop="Dropped at the gate. $human_message"]
  start -> decide
  decide -> ship    [label="[S] Approve merge :: Merges it; it goes live with the next deploy"]
  decide -> revise  [label="[R] Revise :: Your note goes to the session that made it; the change comes back through review"]
  decide -> dropped [label="[D] Drop :: Closes it without merging; the session hears your reason"]
}
