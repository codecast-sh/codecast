// A segment (flows.md FL4): the person who started the run may already have
// said, in their own typed words, that this work should ship. Then the card
// Decide would post only costs them a look, and the change lands on their word.
//
// Asker reads every line a person typed into the sessions the change came
// through (`cast flow asker`: briefs, relays and agent text never appear), each
// person's answers to the decision cards those sessions or the task asked, and
// who started the run, from the run itself. Change is the diff, as the judge
// reads it. Read is a model that answers whether a line or card answer of the
// starter's tells this work to ship, and whether the change stays inside what
// they asked for, citing the line (or the card) and quoting it. Clear (or
// Clear card) hands the citation to the server, which clears the run to land
// only when it is the starter's own word on the change's chain or task and
// holds the quote; code, not the model, is the gate.
//
// Every other ending is Ask, so the flow asks as it would without this
// segment: no session behind the change, a failed script or model call, an
// answer that is not JSON, ship false, out of scope, or a citation the server
// refuses. Each says why on the task in one comment first (the model's why, the
// server's refusal, or the failure), so a read that never works looks different
// from one that rightly asks; Cleared says nothing here, the server comments
// when it clears. Asker removes $run_dir/intent.json first and only a clear writes it,
// with the starter the server checked, the cited line, the quote and the
// commit Change diffed (`head`, kept in $run_dir/intent-head between the two),
// so a flow that composes this segment reads a leftover file as nothing, and a
// commit that lands after the read is not the one the word was read against.
//
//   intent [flow="intent"]
//   intent -> ship   [condition="intent.exit = cleared"]
//   intent -> decide
digraph intent {
  graph [kind="segment", label="Intent", description="Lands the change with no card when the person who started it already said to ship it, in their own typed words", takes="task,branch"]
  start [shape=Mdiamond]
  asker [label="Asker", shape=parallelogram, timeout=120,
    script="rm -f $run_dir/intent.json $run_dir/intent-head; _conv=$change_conversation; _task=$task_id; [ -n \"$_conv\" ] || { echo 'no session started this change'; exit 1; }; cast flow asker \"$_conv\" ${_task:+--task \"$_task\"} --run $run_id"]
  change [label="Change", shape=parallelogram, timeout=120,
    script="_base=$diff_base; _head=\"$(git rev-parse --verify --quiet $branch^{commit})\" || { echo \"the branch $branch does not resolve to a commit here\"; exit 1; }; mkdir -p $run_dir && printf '%s\\n' \"$_head\" > $run_dir/intent-head && cast flow blind diff --base \"${_base:-origin/$default_branch}\" --head \"$_head\" --redact $branch $worktree $change_session $change_conversation"]
  read [label="Read", shape=note, model="claude-opus-5-5", max_tokens=2000, prompt="@intent/asker.md"]
  clear [label="Clear", shape=parallelogram, timeout=120,
    script="_head=\"$(cat $run_dir/intent-head)\" && cast workflow clear $run_id --cite $read.json.session:$read.json.line --quote $read.json.quote --why $read.json.why --record $run_dir/intent.json --head \"$_head\""]
  clear_card [label="Clear card", shape=parallelogram, timeout=120,
    script="_head=\"$(cat $run_dir/intent-head)\" && cast workflow clear $run_id --cite-card $read.json.card --quote $read.json.quote --why $read.json.why --record $run_dir/intent.json --head \"$_head\""]
  declined   [label="Not said", shape=parallelogram, timeout=60,
    script="_task=$task_id; [ -z \"$_task\" ] || cast task comment \"$_task\" \"Intent asked at Decide: $read.json.why\" -t progress > /dev/null || true"]
  unreadable [label="No citation", shape=parallelogram, timeout=60,
    script="_task=$task_id; [ -z \"$_task\" ] || cast task comment \"$_task\" \"Intent asked at Decide: the intent read failed: the model's answer held no usable citation\" -t progress > /dev/null || true"]
  refused    [label="Refused", shape=parallelogram, timeout=60,
    script="_task=$task_id; [ -z \"$_task\" ] || cast task comment \"$_task\" \"Intent asked at Decide: the server did not clear the citation: $last_error\" -t progress > /dev/null || true"]
  failed     [label="Read failed", shape=parallelogram, timeout=60,
    script="_task=$task_id; [ -z \"$_task\" ] || cast task comment \"$_task\" \"Intent asked at Decide: the intent read failed: $last_error\" -t progress > /dev/null || true"]
  cleared [shape=Msquare, label="Cleared"]
  ask     [shape=Msquare, label="Ask"]
  start -> asker
  asker -> change [condition="outcome = success"]
  asker -> failed
  change -> read [condition="outcome = success"]
  change -> failed
  read -> clear [condition="outcome = success and read.json.ship = true and read.json.in_scope = true and read.json.session and read.json.quote and read.json.line > 0"]
  read -> clear_card [condition="outcome = success and read.json.ship = true and read.json.in_scope = true and read.json.card and read.json.quote"]
  read -> declined [condition="outcome = success and read.json.why and (read.json.ship != true or read.json.in_scope != true)"]
  read -> unreadable [condition="outcome = success"]
  read -> failed
  clear -> cleared [condition="outcome = success"]
  clear -> refused
  clear_card -> cleared [condition="outcome = success"]
  clear_card -> refused
  declined -> ask
  unreadable -> ask
  refused -> ask
  failed -> ask
}
