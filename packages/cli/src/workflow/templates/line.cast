// The line (docs/architecture/the-line.md L1, the-line-end-to-end.md LE1 to
// LE12): a role's pipeline for one cause, from grounding it in a goal to a
// shipped, watched change.
//
//   cast workflow run line.cast --task ct-x [--review-backend codex]
//
// Every agent node is a codecast session (backend=session) started
// unattended (L4) and reads only what its prompt names (P7). Each prompt
// lives in its own file under line/ (`prompt="@line/<node>.md"`); a builtin
// run reads them inlined by templates.ts, a run of this file reads them from
// disk. Longer station scripts live there too (`script="@line/<node>.sh"`).
//
// Routing reads the task as it is after every node: the ground fields
// (goal_ref, category, risk, readiness), $handoff and $review_verdict, plus a
// node's JSON output under $<node>.json.<path>. prove and implement share one
// worktree and branch ($worktree, $branch: line-<task id>); $run_dir is the
// run's files (proof, reps, the card), set by the runner before the first node.
//
// What differs per project is the repo's line profile (.codecast/line.toml,
// docs/architecture/line-profile.md), loaded once per run: its commands
// ($line.commands.check|prove|eval|ship), principles, prompting standard,
// size budget and watch days. This file names no repository path and no tool
// of any one project. A command the profile leaves out makes its station pass
// with a note on the task saying the project has none; without a ship command
// the ship station runs Ship (`cast ship run`, docs/architecture/ship.md).
//
// Stations, in order:
//   ground      ties the cause to a goal and rates it; anything not ready, or
//               serving no goal, parks with a comment (LE5)
//   plan        only at risk = plan; a person approves it at plan_gate (LE7)
//   analyze     acceptance criteria for the reviewer
//   prove, red  the miss shown failing first; one that does not reproduce
//               dissolves the cause with its evidence (LE8). A change to the
//               line itself (category line, line-map.md LX6) has its own
//               prove_line, which names the recorded runs that show the miss
//               in line-proof.json, and red checks them against the records
//   implement, verify, green
//               the change, the project's check command, the reproduction
//               now passing; a prompt change goes from verify to eval. A
//               line cause is built by implement_line, on the line's own files
//   ask         a builder that stops to ask (a needs_context or blocked
//               handoff, or a pin that says blocked) puts its question to the
//               person who answers for the project; Answer sends their note
//               back to the builder, Drop closes the cause
//   eval        the project's eval command (it picks what the branch owes),
//               then `cast line eval-result` for the verdict (LP4); an eval
//               that could not judge the change (exit 2: no scored reps on a
//               side) stops at unscored with a blocker, never back at the builder
//   review      the independent reviewer (L3, LE9)
//   card_draft, card_write, card
//               the change card: assembled by code, three fields by a model,
//               validated and published (LE10)
//   decide      Ship, Revise or Drop on the card (LE11)
//   rebase      the branch put on the default branch as the remote has it, and
//               the project's check run on the result, since a card waits and
//               the default branch moves; a conflict or a failing check goes
//               back to implement with what happened on the task, and a change
//               already on the default branch goes on to watch
//   ship        the project's ship command, when it has one: it lands the
//               change its own way and says in one line what is true now;
//               without one, `cast ship run --task`: a ship session opens the
//               pull request and shepherds it, merging only when the profile
//               sets [line.merge] auto or the line's role holds a merge grant
//   watch       the cause watched for the profile's watch days after ship (LE12)
digraph line {
  graph [goal="$task_title", stack="Line · $assignee · $run_date"]
  rankdir=LR

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare,  label="Exit"]

  ground [label="Ground", backend=session, agent=claude, prompt="@line/ground.md"]

  park [label="Park", shape=parallelogram, script="@line/park.sh"]

  plan [label="Plan", backend=session, agent=claude, max_visits=3, prompt="@line/plan.md"]

  plan_gate [label="Plan gate", shape=hexagon, category=approach,
    prompt="Approve the plan for $task_title?",
    doc="$plan.output"]

  analyze [label="Analyze", backend=session, agent=claude, prompt="@line/analyze.md"]

  // The prove hand finds the moments, runs the project's proof (minutes per
  // replayed moment) and usually has to pick again once: three hours.
  prove [label="Prove", backend=session, agent=claude, isolated=true, max_visits=2, timeout=10800, prompt="@line/prove.md"]

  // The check stations run a project's own commands, and a project whose proof
  // replays real moments through an agent, or whose eval owes a gate suite,
  // takes hours, not minutes (Union's gate alone averages fifty minutes). The
  // timeouts are sized for that; a command that hangs is still cut off.
  // A change to the line itself shows its miss on the line's recorded runs.
  prove_line [label="Prove line", backend=session, agent=claude, isolated=true, max_visits=2, timeout=10800, prompt="@line/prove_line.md"]

  red [label="Red", shape=parallelogram, timeout=5400, script="@line/red.sh"]

  dissolve [label="Dissolve", shape=parallelogram, script="@line/dissolve.sh"]

  // The builder runs the project's check and its failing check, which for a
  // prompt is the proof's replays: the same hours as prove.
  implement [label="Implement", backend=session, agent=claude, isolated=true, max_visits=3, timeout=10800, prompt="@line/implement.md"]

  implement_line [label="Build line", backend=session, agent=claude, isolated=true, max_visits=3, timeout=10800, prompt="@line/implement_line.md"]

  // The builder's own words (its handoff evidence, or its blocked pin) are the
  // question; the gate climbs to the person who answers for the project.
  ask [label="Builder asks", shape=hexagon, category=approach,
    prompt="The builder stopped on $task_title ($handoff) and needs an answer to go on.",
    doc="$handoff_note"]

  verify [label="Verify", shape=parallelogram,
    timeout=3600,
    script="cd \"$(cast ws path $worktree)\" && bash -c $line.commands.check"]

  green [label="Green", shape=parallelogram, timeout=1800, script="@line/green.sh"]

  eval [label="Eval", shape=parallelogram, timeout=10800, script="@line/eval.sh"]

  unscored [label="Unscored", shape=parallelogram,
    script="note=$eval.output; cast task comment $task_id \"The eval station could not judge the change, so the builder was not sent back. Rerun the line once the eval can run.${note:+ $note}\" -t blocker"]

  review [label="Review", backend=session, agent=claude, reviewer=true, prompt="@line/review.md"]

  card_draft [label="Card draft", shape=parallelogram, timeout=300,
    script="cd \"$(cast ws path $worktree)\" || exit 1; cast card build --task $task_id --dir $run_dir --base $default_branch --json; exit 0"]

  card_write [label="Card words", shape=tab, backend=session, agent=claude, max_visits=2, prompt="@line/card_write.md"]

  card [label="Card", shape=parallelogram, timeout=300,
    script="cd \"$(cast ws path $worktree)\" && cast card build --task $task_id --dir $run_dir --base $default_branch --publish --headline $card_write.json.headline --context $card_write.json.context --wrong $card_write.json.wrong --change $card_write.json.change --recommend $card_write.json.recommend --why $card_write.json.why"]

  decide [label="Decide", shape=hexagon, category=review,
    prompt="Ship this change? $card_write.json.headline",
    doc="$card_write.json.context\n\nWhat is wrong: $card_write.json.wrong\n\nWhat this changes: $card_write.json.change\n\nRecommends $card_write.json.recommend: $card_write.json.why",
    card="$run_dir/card.json"]

  reopen [label="Reopen", shape=parallelogram, script="cast task update $task_id -s in_progress"]

  drop [label="Drop", shape=parallelogram,
    script="note=$human_message; cast task drop $task_id -m \"Dropped at the gate.${note:+ $note}\""]

  // The check runs again when the base moved: the same hour verify has.
  rebase [label="Rebase", shape=parallelogram, timeout=3600, script="@line/rebase.sh"]

  ship [label="Ship", shape=parallelogram, timeout=3600, script="@line/ship.sh"]

  watch [label="Watch", shape=parallelogram, script="cast task update $task_id --watch-days $line.watch_days"]

  start -> ground
  ground -> park    [condition="readiness != ready or goal_ref = none or not goal_ref"]
  ground -> plan    [condition="readiness = ready and goal_ref and goal_ref != none and risk = plan"]
  ground -> analyze [condition="readiness = ready and goal_ref and goal_ref != none and risk != plan"]
  park -> exit

  plan -> plan_gate
  plan_gate -> analyze [label="[A] Approve :: Build to this plan"]
  plan_gate -> plan    [label="[R] Revise :: Your note goes back to the planner"]
  plan_gate -> drop    [label="[D] Drop :: Close the cause with your reason"]

  // A line cause takes its own prove and build stations; every route back to
  // the builder goes to the one its category names.
  analyze -> prove      [condition="category != line"]
  analyze -> prove_line [condition="category = line"]
  prove -> red       [condition="prove.json.reproduced = true"]
  prove -> dissolve  [condition="prove.json.reproduced = false"]
  prove_line -> red      [condition="prove_line.json.reproduced = true"]
  prove_line -> dissolve [condition="prove_line.json.reproduced = false"]
  red -> implement      [condition="red.json.red = true and category != line"]
  red -> implement_line [condition="red.json.red = true and category = line"]
  red -> prove          [condition="red.json.red != true and category != line", label="no miss shown"]
  red -> prove_line     [condition="red.json.red != true and category = line", label="no miss shown"]
  dissolve -> exit

  implement -> verify      [condition="handoff = done"]
  implement_line -> verify [condition="handoff = done"]
  implement -> ask         [condition="handoff = needs_context or handoff = blocked"]
  implement_line -> ask    [condition="handoff = needs_context or handoff = blocked"]
  ask -> reopen            [label="[A] Answer :: Your answer goes back to the builder"]
  ask -> drop              [label="[D] Drop :: Close the cause with your reason"]
  verify -> green          [condition="outcome = success and category != prompt"]
  verify -> eval           [condition="outcome = success and category = prompt"]
  verify -> implement      [condition="outcome = failure and category != line", label="checks failed"]
  verify -> implement_line [condition="outcome = failure and category = line", label="checks failed"]
  green -> eval            [condition="outcome = success"]
  green -> implement       [condition="outcome = failure and category != line", label="still red"]
  green -> implement_line  [condition="outcome = failure and category = line", label="still red"]
  eval -> review           [condition="outcome = success"]
  eval -> implement        [condition="outcome = failure and eval.exit_code = 1 and category != line", label="eval failed"]
  eval -> implement_line   [condition="outcome = failure and eval.exit_code = 1 and category = line", label="eval failed"]
  eval -> unscored       [condition="outcome = failure and eval.exit_code != 1", label="eval could not score"]
  unscored -> exit

  review -> card_draft [condition="review_verdict = approve"]
  review -> implement      [condition="review_verdict = changes and category != line", label="changes"]
  review -> implement_line [condition="review_verdict = changes and category = line", label="changes"]
  review -> exit       [condition="review_verdict = reject"]

  card_draft -> card_write
  card_write -> card
  card -> decide     [condition="outcome = success"]
  card -> card_write [condition="outcome = failure", label="card refused"]

  decide -> rebase [label="[S] Ship :: Land the change, then watch the cause"]
  decide -> reopen [label="[R] Revise :: Your note goes back to the builder"]
  decide -> drop   [label="[D] Drop :: Close the cause with your reason"]
  reopen -> implement      [condition="category != line"]
  reopen -> implement_line [condition="category = line"]
  drop -> exit

  rebase -> ship      [condition="outcome = success and rebase.json.landed != true"]
  rebase -> watch     [condition="outcome = success and rebase.json.landed = true", label="already landed"]
  rebase -> implement      [condition="outcome = failure and rebase.exit_code = 1 and category != line", label="conflict or check failed"]
  rebase -> implement_line [condition="outcome = failure and rebase.exit_code = 1 and category = line", label="conflict or check failed"]
  rebase -> ship      [condition="outcome = failure and rebase.exit_code != 1", label="could not rebase"]
  ship -> watch  [condition="outcome = success"]
  ship -> exit   [condition="outcome = failure", label="not shipped"]
  watch -> exit
}
