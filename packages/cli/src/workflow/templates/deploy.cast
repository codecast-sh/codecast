// A segment (flows.md FL2, FL4): after Merge, the run takes the commit it put
// on the default branch ($run_dir/merge.json, else the merge recorded on the
// run) out to every target the change's files touch (deploys.md DP10 to DP15),
// and ends Live only when every one of them carries it. It sends the `release`
// targets (`cast deploy`; `send` defaults to release, the library's default),
// waits on the ones that deploy themselves (`push`, and `auto` once main CI is
// green), and only waits, never sends, on `press` targets and the target the
// line profile's [line.deploy] sends: a person or a role sends those, and the
// run gives them a day. A flow that composes it with `send=""` sends nothing
// and only waits (a team whose deploys a person sends). Every wait names its
// target, what it waits for, how long it has waited and its deadline; a missed
// deadline, or the wait's cap (the longest deadline and an hour), posts one
// blocker on the task and stops at Deploy stuck. A run with no merged commit
// stops at once at Not merged. The wait parks: while it stands here the run
// holds no slot and no session. A flow that composes it may name targets the
// change does not wait for (`except="agent-worker"`): one held back on
// purpose, whose live sha is not what the change's watch should start on; it
// still holds the targets that go after it. It runs in the run's checkout, never
// the run's worktree: what it needs is merge.json's sha, origin and the
// checkout's deploy targets, and the worktree may be gone by the time the
// change is merged (ct-99406).
digraph deploy {
  graph [kind="segment", label="Deploy", description="Send the merged change's release targets, and wait until it is live on every target it touches", takes="branch", params="except send=release"]
  start [shape=Mdiamond]
  wait [label="Go live", shape=parallelogram, parks=true, timeout=90900,
    script="cast flow await-deploy --merge \"$run_dir/merge.json\" --base $default_branch --branch \"$branch\" --run $run_id --node $station_id --task \"$task_id\" --files \"$change_files\" --except \"$except\" --send \"$send\""]
  live     [shape=Msquare, label="Live"]
  unmerged [shape=Msquare, label="Not merged", stop="$wait.output"]
  stuck    [shape=Msquare, label="Deploy stuck", shared=true, stop="$wait.output"]
  failed   [shape=Msquare, label="Deploy failed", shared=true, stop="$wait.output"]
  start -> wait
  wait -> live     [condition="outcome = success"]
  wait -> unmerged [condition="outcome = failure and wait.exit_code = 4"]
  wait -> stuck    [condition="outcome = failure and wait.exit_code = 5"]
  wait -> failed   [condition="outcome = failure and wait.exit_code != 4 and wait.exit_code != 5"]
}
