// A segment (flows.md FL2, FL4): after a change lands, the run waits for the
// deploy that carries it on every target its files touch (deploys.md DP10 to
// DP13), and ends live with the dp-N per target, or stopped when that deploy
// failed. With `send="release"` it first sends the targets the change touches
// whose policy is `release` (`cast deploy`, deploys.md DP15), as a release of
// main does; every other target goes out by its own policy (a press, CI on
// main, a push that deploys itself). The wait parks: while it stands here the run
// holds no slot and no session. A change that never lands waits out the
// station's week. A flow that composes it may name targets the change does
// not wait for (`except="aivery-operator"`): one held back on purpose, whose
// live sha is not what the change's watch should start on.
digraph deploy {
  graph [kind="segment", label="Deploy", description="Send the landed change's release targets when asked to, and wait until it is live on every target it touches", takes="branch", params="except send"]
  start [shape=Mdiamond]
  wait [label="Go live", shape=parallelogram, parks=true, timeout=604800,
    script="wt=\"$(cast ws path $worktree)\"; [ -n \"$wt\" ] && cd \"$wt\" && cast flow await-deploy --branch $branch --base $default_branch --run $run_id --node $station_id --files \"$change_files\" --except \"$except\" --send \"$send\""]
  live   [shape=Msquare, label="Live"]
  failed [shape=Msquare, label="Deploy failed", stop="$wait.output"]
  start -> wait
  wait -> live   [condition="outcome = success"]
  wait -> failed [condition="outcome = failure"]
}
