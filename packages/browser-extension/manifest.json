{
  "manifest_version": 3,
  "name": "Cast Browser Bridge",
  "version": "0.1.0",
  "key": "",
  "description": "Lets the cast CLI drive tabs in this Chrome over a token-authenticated localhost bridge. Driven tabs show Chrome's debugging banner and a badge.",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Cast Browser Bridge — not connected"
  }
}
