{
  "manifest_version": 3,
  "name": "Codecast",
  "short_name": "Codecast",
  "version": "0.1.0",
  "key": "",
  "description": "Lets codecast agents open their own tabs in this Chrome, in a tab group named after the session, over a token authenticated localhost bridge. Chrome shows its debugging notice on driven tabs.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Codecast: not connected",
    "default_popup": "popup.html"
  }
}
