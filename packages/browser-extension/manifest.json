{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Codecast",
  "short_name": "Codecast",
  "version": "0.1.3",
  "key": "",
  "description": "Lets Codecast agents open and drive their own tabs in this Chrome, in one tab group, over a local token authenticated bridge.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Codecast: not connected",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "options.html"
      ],
      "matches": [
        "file:///*"
      ]
    }
  ]
}
