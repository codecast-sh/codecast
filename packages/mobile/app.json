{
  "expo": {
    "name": "Codecast",
    "slug": "codecast",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.4",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "codecast",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "owner": "ashotp",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ashotp.codecast",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:codecast.sh",
        "applinks:www.codecast.sh"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "voip"
        ],
        "NSFaceIDUsageDescription": "Use Face ID to securely access your account",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Codecast uses the camera for team huddles.",
        "NSMicrophoneUsageDescription": "Codecast uses the microphone for team huddles."
      },
      "deploymentTarget": "16.0"
    },
    "android": {
      "package": "com.ashotp.codecast",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "codecast.sh", "pathPrefix": "/session" },
            { "scheme": "https", "host": "codecast.sh", "pathPrefix": "/conversation" },
            { "scheme": "https", "host": "codecast.sh", "pathPrefix": "/task" },
            { "scheme": "https", "host": "codecast.sh", "pathPrefix": "/plan" },
            { "scheme": "https", "host": "codecast.sh", "pathPrefix": "/doc" },
            { "scheme": "https", "host": "codecast.sh", "pathPrefix": "/share" },
            { "scheme": "https", "host": "codecast.sh", "pathPrefix": "/join" },
            { "scheme": "https", "host": "www.codecast.sh", "pathPrefix": "/session" },
            { "scheme": "https", "host": "www.codecast.sh", "pathPrefix": "/conversation" },
            { "scheme": "https", "host": "www.codecast.sh", "pathPrefix": "/task" },
            { "scheme": "https", "host": "www.codecast.sh", "pathPrefix": "/plan" },
            { "scheme": "https", "host": "www.codecast.sh", "pathPrefix": "/doc" },
            { "scheme": "https", "host": "www.codecast.sh", "pathPrefix": "/share" },
            { "scheme": "https", "host": "www.codecast.sh", "pathPrefix": "/join" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/a2698c27-7e77-4406-aae2-063844898e60"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#d97706",
          "sounds": [
            "./assets/sounds/chat.caf",
            "./assets/sounds/huddle-ring.caf"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "codecast-a2",
          "project": "react-native"
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-callkit-telecom",
        {
          "sounds": [
            "./assets/sounds/huddle-ring.caf"
          ],
          "defaultRingtoneIos": "huddle-ring.caf",
          "incomingCallTimeout": 45,
          "fulfillAnswerCallTimeout": 30
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2698c27-7e77-4406-aae2-063844898e60"
      }
    }
  }
}
