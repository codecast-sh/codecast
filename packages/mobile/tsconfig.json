{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    // Same rule as packages/web: test files run under `bun test`, which supplies
    // the `bun:test` module and `import.meta.dir`. The app typecheck has no bun
    // types, so a full tsc flags every test file on its imports. Tests aren't app
    // code — bun type-checks them on its own.
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
