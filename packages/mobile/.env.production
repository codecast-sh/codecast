# Bundled into production JS by `expo export` / `eas update` (NODE_ENV=production).
# EXPO_PUBLIC_* values are public — this is the self-hosted Convex endpoint, not
# a secret. Without this file, an OTA published from a shell that doesn't export
# the var ships an empty Convex URL and the app can't connect (observed 2026-07-05).
EXPO_PUBLIC_CONVEX_URL=https://convex.codecast.sh

# Analytics. Same public-value rationale: the Sentry DSN and PostHog project
# key are client-side identifiers, not secrets. Keeping them here (tracked)
# means a build or OTA published from any machine ships with telemetry on —
# the gitignored .env does not travel.
EXPO_PUBLIC_SENTRY_DSN=https://f1cb6a5a75426ef1fc23b783393cab01@o4511096630083584.ingest.us.sentry.io/4511096656560129
EXPO_PUBLIC_POSTHOG_KEY=phc_Qfq3Fhk6pyxB8vkDoUVqSKvAgiVkqR3ARoAtwaYqE6Z
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
