{
  "name": "@codecast/electron",
  "version": "1.1.133",
  "description": "Codecast Desktop (Electron)",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "native": "scripts/build-native.sh",
    "prestart": "npm run native",
    "predev": "npm run native",
    "prebuild": "npm run native",
    "prebuild:dir": "npm run native",
    "prebuild:local": "npm run native",
    "start": "electron .",
    "dev": "CODECAST_URL=https://local.codecast.sh electron .",
    "test": "node --test *.test.js installedApps/*.test.js appshim/*.test.js",
    "build": "NOTARIZE_KEYCHAIN_PROFILE=codecast electron-builder -m",
    "build:dir": "electron-builder -m --config.mac.target=dir",
    "build:local": "electron-builder -m --config.mac.target=dir --config.mac.identity=null",
    "install:local": "npm run build:local && { pkill -f Codecast.app 2>/dev/null; sleep 1; } && rm -rf /Applications/Codecast.app && cp -R dist/mac-arm64/Codecast.app /Applications/Codecast.app && xattr -cr /Applications/Codecast.app && echo 'Installed to /Applications'",
    "build:win": "scripts/build-win.sh",
    "icon:win": "scripts/make-icon-ico.sh"
  },
  "dependencies": {
    "@platform/desktop": "file:../../platform/packages/desktop"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "sh.codecast.desktop",
    "productName": "Codecast",
    "files": [
      "main.js",
      "shellAuthority.js",
      "settingsFile.js",
      "appWindows.mjs",
      "callWindowPolicy.js",
      "paletteFace.js",
      "meetingDetector.js",
      "agentDock.js",
      "notificationRouter.js",
      "osPermissions.js",
      "computerPermissions.js",
      "daemonSetup.js",
      "browserPanes.js",
      "shareCursors.js",
      "spellMenu.js",
      "editUndo.js",
      "menuKeys.js",
      "shellRecovery.js",
      "shortcutSettings.js",
      "updaterNet.js",
      "updatePolicy.js",
      "winInstaller.js",
      "smokeTest.js",
      "rendererLog.js",
      "preload.js",
      "native/notifications.node",
      "assets/icon.png",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png",
      "assets/trayAttention.png",
      "assets/trayAttention@2x.png",
      "assets/trayColor.png",
      "assets/trayColorAttention.png",
      "trayIcon.js",
      "installedApps/host.js",
      "installedApps/registry.js",
      "installedApps/consentWindow.js",
      "installedApps/icons.js",
      "installedApps/electronHost.js",
      "installedApps/macHost.js",
      "installedApps/engine.js",
      "installedApps/protocol.js",
      "installedApps/fullAccess.js",
      "installedApps/tiers.json",
      "installedApps/client.js",
      "installedApps/appPreload.js",
      "installedApps/agentAsk.js",
      "installedApps/sourceOverrides.js",
      "appshim/install.js"
    ],
    "asarUnpack": [
      "native/*.node"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "beforePack": "scripts/build-appshim.js",
    "afterSign": "notarize.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "minimumSystemVersion": "13.0",
      "identity": "Ashot Petrosian (WRG9THCK9Q)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Codecast uses the microphone for team huddles.",
        "NSCameraUsageDescription": "Codecast uses the camera for team huddles.",
        "NSAudioCaptureUsageDescription": "Codecast records system audio when you record a meeting or share your screen with sound."
      },
      "extraResources": [
        {
          "from": "appshim/build/CodecastAppShim",
          "to": "appshim/CodecastAppShim"
        }
      ]
    },
    "dmg": {
      "title": "Codecast",
      "artifactName": "Codecast-${version}-arm64.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Codecast-${version}-${arch}-setup.${ext}",
      "shortcutName": "Codecast",
      "uninstallDisplayName": "Codecast",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "include": "scripts/windows-installer.nsh"
    },
    "protocols": [
      {
        "name": "Codecast",
        "schemes": [
          "codecast"
        ]
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://dl.codecast.sh/desktop"
    }
  }
}
