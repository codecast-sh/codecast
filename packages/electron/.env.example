# Environment variables the desktop shell and its build read.
#
# Nothing loads this file: there is no dotenv step. Each variable is read
# straight from the process environment, so set it in the shell that runs the
# command (`CODECAST_URL=… npm start`). This file is the list.

# ── Running (main.js) ────────────────────────────────────────────────────────

# The web app this shell opens. Default: https://codecast.sh. `npm run dev`
# sets it to https://local.codecast.sh.
CODECAST_URL=https://your-codecast-instance.example.com

# A separate profile directory, so a from-source run can sit beside the
# installed app (own singleton lock, IndexedDB and localStorage).
CODECAST_USER_DATA=

# Chrome DevTools Protocol port for the browser panes. A from-source run
# defaults to 9333; a packaged build has none unless this is set.
CODECAST_CDP_PORT=

# Set to 1 to let a from-source run claim the codecast:// scheme. Off by
# default: every node_modules Electron shares one bundle id, so claiming it
# rebinds the installed app's links.
CODECAST_CLAIM_PROTOCOL=

# The codecast CLI's directory. Default: ~/.codecast.
CODECAST_DIR=

# ── Building (notarize.js, the afterSign hook) ───────────────────────────────
# First match wins. With none set, the build prints "Skipping notarization".

# 1. App Store Connect API key (notarize.js supplies the team's key when its
#    file exists under ~/.app-store-connect)
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# 2. Keychain profile (`npm run build` sets this to "codecast")
NOTARIZE_KEYCHAIN_PROFILE=

# 3. Apple ID credentials
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
