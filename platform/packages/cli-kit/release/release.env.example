# Copy to release.env (gitignored) or export in the shell. Every script in this
# directory reads these. Values here are placeholders.
PRODUCT_NAME="Acme"                      # human name in messages
BINARY_NAME="acme"                       # binary file name, release asset prefix
ALIAS_NAME="ac"                          # optional short alias symlinked beside the binary
ENTRYPOINT="src/index.ts"                # what bun compiles
OUTPUT_DIR="../web/binaries"             # where binaries land, relative to the CLI package
RELEASE_BASE_URL="https://dl.example.com" # public origin in front of the bucket
R2_BUCKET="acme"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID="<r2-access-key>"
AWS_SECRET_ACCESS_KEY="<r2-secret>"
GITHUB_REPO="acme-org/acme"              # owner/repo that hosts releases
HOMEBREW_TAP_REPO="acme-org/homebrew-tap"
HOMEBREW_FORMULA_CLASS="Acme"            # Ruby class name
HOMEBREW_DESC="One line description"
HOMEPAGE="https://example.com"
LICENSE="MIT"
SIGN_IDENTITY="Developer ID Application: <name> (<team-id>)"  # macOS codesign identity
SIGN_IDENTIFIER="com.example.acme.cli"   # stable bundle identifier for codesign
# NPM_TOKEN="<granular-token>"           # optional, for unattended npm publish
