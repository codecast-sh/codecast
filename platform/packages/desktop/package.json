{
  "name": "@platform/desktop",
  "version": "0.1.0",
  "description": "Electron shell with a self-contained macOS updater, parameterized for any web app",
  "type": "commonjs",
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./preload": "./src/preload.js",
    "./vite": {
      "types": "./templates/vite-release-manifest.d.ts",
      "default": "./templates/vite-release-manifest.js"
    },
    "./templates/electron-builder": "./templates/electron-builder.js",
    "./templates/*": "./templates/*"
  },
  "files": [
    "src",
    "templates",
    "index.d.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@electron/notarize": ">=2",
    "electron": ">=28",
    "electron-builder": ">=24"
  },
  "peerDependenciesMeta": {
    "@electron/notarize": {
      "optional": true
    },
    "electron-builder": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
