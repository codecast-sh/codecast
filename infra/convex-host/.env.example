# Copy to .env on the host and fill in. NEVER commit the filled copy.
# Captured from the live Railway service on 2026-09-10 — this is the parity
# checklist the cutover runbook refers to. A missing var here does not fail
# loudly at boot; it fails later on a specific query, looking like data
# corruption rather than a config error.

# Identity. Both MUST carry over from Railway unchanged or every existing
# credential, token and admin key stops validating.
INSTANCE_NAME=codecast
INSTANCE_SECRET=<from railway: convex-backend INSTANCE_SECRET>

# Origins. Unchanged by the migration: clients reach us at this name and the
# cutover is an origin change behind it, so nothing client-side moves.
CONVEX_CLOUD_ORIGIN=https://convex.codecast.sh
CONVEX_SITE_ORIGIN=https://convex.codecast.sh
NEXT_PUBLIC_CONVEX_URL=https://convex.codecast.sh
SITE_URL=https://codecast.sh

# Postgres. The database runs in its own container on the `codecast` docker
# network, so the host name here is that container's name, not localhost: the
# backend resolves `postgres` only because both join that network (see the
# networks block in docker-compose.yml).
#
# ?sslmode=disable IS REQUIRED and is not decoration. Without it the backend
# negotiates TLS, and the database presents its CA certificate as its own server
# certificate, so the handshake fails with
#   invalid peer certificate: Other(OtherError(CaUsedAsEndEntity))
# and the container restart loops. DO_NOT_REQUIRE_SSL alone does not prevent the
# attempt. Railway's original value carried this parameter; rebuilding the URL
# without it cost four minutes of downtime at cutover on 2026-09-15.
#
# The URL carries NO database path: convex appends the instance name.
POSTGRES_URL=postgresql://postgres:<password>@postgres:5432?sslmode=disable
DO_NOT_REQUIRE_SSL=true

# Retention. NOT defaults, and both were set for concrete reasons:
# DOCUMENT_RETENTION_DELAY 5 days (down from 21) cut MVCC bloat that had grown
# the database to 162 GB. INDEX_RETENTION_DELAY 1 hour (down from 3 days) was
# set on 2026-09-02 to stop an index-tombstone pile causing system-op timeouts.
DOCUMENT_RETENTION_DELAY=432000
INDEX_RETENTION_DELAY=3600

# Concurrency. Raised from upstream defaults; tune against real hardware only
# after measuring, since past a threshold more concurrency degrades throughput.
APPLICATION_MAX_CONCURRENT_QUERIES=64
APPLICATION_MAX_CONCURRENT_MUTATIONS=64
APPLICATION_MAX_CONCURRENT_V8_ACTIONS=64
APPLICATION_MAX_CONCURRENT_NODE_ACTIONS=64

# Transaction limits. CRITICAL and NOT defaults — upstream ships 32000 rows and
# 16 MB. Our functions depend on the raised values; shipping the defaults breaks
# specific queries only, at runtime, well after a clean-looking boot.
TRANSACTION_MAX_READ_SIZE_ROWS=128000
TRANSACTION_MAX_READ_SIZE_BYTES=104857600

# Cap on USER JS time per query/mutation; db waits are excluded (those hit the
# separate 15s DATABASE_UDF_SYSTEM_TIMEOUT_SECONDS). Upstream default is 1s, a
# fairness limit for shared cloud isolates. Raised to 3s on 2026-09-16: JS time
# here is bytes moved (deserializing ~1100 conversation docs and serializing a
# 2 MB inbox return costs listInboxSessions 0.27s p50), and a CPU spike on this
# shared box doubled it past 1s, which the client surfaced as a dead dashboard.
# Set in /srv/convex/.env; recreate the backend container to apply.
DATABASE_UDF_USER_TIMEOUT_SECONDS=3

# Logging. tantivy=error suppresses a warning flood from the damaged search
# index that once drowned the log stream past the host's rate limit.
RUST_LOG=info,tantivy=error
